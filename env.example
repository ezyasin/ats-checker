# Copy this file to .env.local before running the app.
# At least one provider API key is required.

# Preferred default provider when multiple providers are configured.
# Supported values: claude, gemini, openai
LLM_PROVIDER=gemini

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Upload limit in bytes. Default is 5 MB.
MAX_FILE_SIZE=5242880
